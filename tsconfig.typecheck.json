// Type-checking-only config (NOT used by the rollup build). Run via `npm run typecheck`.
// Mirrors the base tsconfig (loose: noImplicitAny:false, strict off except ratcheted strict flags) but scoped to
// src/ with skipLibCheck, so it's a clean green/red compile signal — exits 0 today.
//
// This is the ratchet: it must stay at 0 errors. Treat any new error as a regression
// to fix before merging. The decaffeinated object-literal singletons are now typed
// (late-assigned properties declared on each literal; loose `any` where a precise
// type would cascade — grep `// loose:` for the spots to tighten later).
//
// NOTE: full `strict` still has errors from the remaining strict flags, so strict
// remains a future burndown, not a freebie. noImplicitAny:false is load-bearing here.
//
// Scoped to src/ — tools/ has its own tools/tsconfig.json (node16 + @types/node).
// fbegin.js/fend.js are intentionally-invalid dead build fragments, excluded.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "strictBuiltinIteratorReturn": true,
    "alwaysStrict": true
  },
  "include": ["src"],
  "exclude": [
    "src/meta/fbegin.js",
    "src/meta/fend.js",
    // Node build-time script (uses fs/promises, path, url); not browser runtime
    // source, so it's checked by the build tooling, not this browser-targeted config.
    "src/meta/metadata.js"
  ]
}
